  "textos": {
    "historia": "Asotaxis —la Asociación de Taxistas al Servicio Urbano Individual de Fusagasugá— reúne a taxistas de la ciudad y maneja una de las centrales de taxi más conocidas de Fusa, con línea telefónica, oficina sobre la Avenida Las Palmas y una app de reservas para Android.\n\nCon la app, la central puede dar el siguiente paso: pedir el taxi con la ubicación exacta desde Android o desde iPhone, ver la tarifa antes de subir, seguir el taxi en el mapa y pagar con QR, mientras cada conductor recibe los servicios en su propia app.",
    "mision": "Prestar el servicio de taxi en Fusagasugá con taxistas que conocen la ciudad, con buen trato, seguridad y tarifas claras, y una central que responde rápido a cada pedido.",
    "vision": "Ser la central de taxis de Fusagasugá que todos tienen en el celular: se pide en segundos, se sabe el precio antes de subir y se ve el taxi en el mapa.",
    "servicios": [
      "Central de taxis por teléfono y app",
      "Taxi en el casco urbano de Fusagasugá",
      "Servicio a las veredas",
      "Traslados a la Terminal de Transportes",
      "Viajes especiales a Bogotá y al aeropuerto"
    ],
    "frase": "La central de taxis de Fusa, en Android y en iPhone"
  },
  "fuentes": [
    "https://play.google.com/store/apps/details?id=com.asotaxisfusa.fusagasuga&hl=es",
    "https://www.facebook.com/asotaxis/",
