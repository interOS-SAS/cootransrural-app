  "textos": {
    "historia": "Taxis Los Dos S.A.S. es una de las dos empresas de taxi de Soacha. Está registrada desde 2009 como empresa de transporte de pasajeros y presta el servicio de taxi a la comunidad del municipio, con su línea de atención para pedidos, quejas y sugerencias.\n\nCon esta app, Taxis Los Dos puede llevar su servicio al celular con su propia marca: pides el taxi con tu ubicación exacta, ves cuántos taxis hay libres, conoces la tarifa antes de subir, sigues el móvil en el mapa hasta tu puerta y pagas con QR o en efectivo.",
    "mision": "Prestar el servicio de taxi en Soacha con conductores que conocen el municipio, con seguridad, puntualidad, tarifas claras y buen trato para cada pasajero.",
    "vision": "Ser la forma más fácil de pedir un taxi en Soacha: un toque en el celular, la tarifa clara y el móvil en el mapa.",
    "servicios": [
      "Taxi en Soacha",
      "Pedidos por teléfono a la central",
      "Carreras con la tarifa oficial",
      "Atención de quejas y sugerencias"
    ],
    "frase": "Tu taxi en Soacha"
  },
  "fuentes": [
    "https://periodismopublico.com/en-soacha-denuncian-abuso-de-taxistas-en-el-cobro-de-tarifas",
    "https://www.datos.gov.co/resource/c82u-588k.json?nit=900291342",
